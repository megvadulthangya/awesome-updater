#!/usr/bin/env bash
# Mock systemctl.

if [ -n "${MOCK_LOG:-}" ]; then
    printf 'systemctl' >> "$MOCK_LOG"
    for a in "$@"; do printf ' %s' "$a" >> "$MOCK_LOG"; done
    printf '\n' >> "$MOCK_LOG"
fi

sub="${1:-}"
[ "$#" -gt 0 ] && shift

case "$sub" in
    is-active)
        [ "${1:-}" = "--quiet" ] && shift
        unit="${1:-}"
        for u in ${MOCK_SYSTEMCTL_ACTIVE_UNITS:-}; do
            [ "$u" = "$unit" ] && exit 0
        done
        exit 3
        ;;
    list-unit-files)
        # Consumes any "--type=timer" / "--no-legend" arguments and returns
        # the configured enabled timers in the same format systemd uses.
        for t in ${MOCK_SYSTEMCTL_ENABLED_TIMERS:-}; do
            printf '%s enabled\n' "$t"
        done
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
#!/usr/bin/env bash
# Mock uname.

if [ -n "${MOCK_LOG:-}" ]; then
    printf 'uname' >> "$MOCK_LOG"
    for a in "$@"; do printf ' %s' "$a" >> "$MOCK_LOG"; done
    printf '\n' >> "$MOCK_LOG"
fi

if [ "${1:-}" = "-r" ]; then
    printf '%s\n' "${MOCK_UNAME_R:-6.18.50-1-MANJARO}"
    exit 0
fi

for p in /usr/bin/uname /bin/uname; do
    if [ -x "$p" ]; then
        exec "$p" "$@"
    fi
done
printf 'Linux\n'
#!/usr/bin/env bash
# Mock crontab.

if [ -n "${MOCK_LOG:-}" ]; then
    printf 'crontab' >> "$MOCK_LOG"
    for a in "$@"; do printf ' %s' "$a" >> "$MOCK_LOG"; done
    printf '\n' >> "$MOCK_LOG"
fi

FILE="${MOCK_CRONTAB_FILE:-/tmp/mock.crontab}"

case "${1:-}" in
    -l)
        if [ -r "$FILE" ]; then
            cat "$FILE"
            exit 0
        fi
        exit 1
        ;;
    -)
        cat > "$FILE"
        exit "${MOCK_CRONTAB_INSTALL_EXIT:-0}"
        ;;
    *)
        exit 0
        ;;
esac
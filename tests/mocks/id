#!/usr/bin/env bash
# Mock id.

if [ -n "${MOCK_LOG:-}" ]; then
    printf 'id' >> "$MOCK_LOG"
    for a in "$@"; do printf ' %s' "$a" >> "$MOCK_LOG"; done
    printf '\n' >> "$MOCK_LOG"
fi

if [ "${1:-}" = "-u" ]; then
    printf '%s\n' "${MOCK_ID_U:-1000}"
    exit 0
fi

# For non -u invocations, delegate to the real binary.
for p in /usr/bin/id /bin/id; do
    if [ -x "$p" ]; then
        exec "$p" "$@"
    fi
done
exit 0
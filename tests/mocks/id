#!/usr/bin/env bash
# Mock id.
#
# * "id -u"          -> prints MOCK_ID_U (default 1000)
# * "id -u <user>"   -> looks up <user> in MOCK_PASSWD_FILE
# * "id <user>"      -> returns 0 if <user> exists in MOCK_PASSWD_FILE
# * any other form   -> delegates to the real id

if [ -n "${MOCK_LOG:-}" ]; then
    printf 'id' >> "$MOCK_LOG"
    for a in "$@"; do printf ' %s' "$a" >> "$MOCK_LOG"; done
    printf '\n' >> "$MOCK_LOG"
fi

if [ "${1:-}" = "-u" ]; then
    if [ "$#" -ge 2 ]; then
        name="$2"
        if [ -n "${MOCK_PASSWD_FILE:-}" ] && [ -r "$MOCK_PASSWD_FILE" ]; then
            while IFS=: read -r u _ uid _ _ _ _; do
                if [ "$u" = "$name" ]; then
                    printf '%s\n' "$uid"
                    exit 0
                fi
            done < "$MOCK_PASSWD_FILE"
        fi
        exit 1
    fi
    printf '%s\n' "${MOCK_ID_U:-1000}"
    exit 0
fi

if [ "$#" -eq 1 ] && [ "${1#-}" = "$1" ]; then
    name="$1"
    if [ -n "${MOCK_PASSWD_FILE:-}" ] && [ -r "$MOCK_PASSWD_FILE" ]; then
        while IFS=: read -r u _ _ _ _ _ _; do
            if [ "$u" = "$name" ]; then
                exit 0
            fi
        done < "$MOCK_PASSWD_FILE"
    fi
    exit 1
fi

for p in /usr/bin/id /bin/id; do
    if [ -x "$p" ]; then
        exec "$p" "$@"
    fi
done
exit 0
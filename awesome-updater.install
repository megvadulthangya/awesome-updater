pre_install() {
    # Non-destructive migration detection.
    #
    # A previous manual installation may have left files that are not
    # owned by any package. pacman refuses to overwrite such files, so
    # the first installation of this package can fail with a
    # "file exists in filesystem" error. This notice lists the affected
    # paths and instructs the user to review and remove them by hand.
    #
    # This scriptlet never deletes anything.
    _legacy_paths=""
    for _f in \
        /etc/profile.d/99-system-update.sh \
        /etc/system-update/config.conf \
        /usr/bin/system-update \
        /usr/bin/system-update-notify \
        /usr/local/bin/system-update \
        /usr/local/bin/system-update-notify
    do
        if [ -e "$_f" ] && ! pacman -Qo "$_f" >/dev/null 2>&1; then
            _legacy_paths="$_legacy_paths
  $_f"
        fi
    done

    if [ -n "$_legacy_paths" ]; then
        cat <<EOF
:: awesome-updater migration notice
::
:: The following files exist on disk but are not owned by any package.
:: They were most likely created by a previous manual installation.
:: pacman cannot overwrite these files, so this transaction may fail
:: with a "file exists in filesystem" error.
::$_legacy_paths
::
:: Review each file, then remove or relocate it manually, for example:
::
::     sudo rm -f <path>
::
:: The updater does NOT delete these files automatically.
EOF
    fi

    unset _legacy_paths _f
}

post_install() {
    cat <<'EOF'
:: awesome-updater has been installed.

The package works with its defaults. No manual configuration is required.

Default configuration:
    /etc/system-update/config.conf

Optional per-user override:
    ~/.config/system-update/config.conf

Main command:
    system-update

Logs:
    ~/logs/latest_update.log

Runtime state:
    /var/lib/system-update/

AUR updates are disabled by default. To enable them, set:
    AUR_ENABLED=true
in the configuration file.

The package does NOT create a crontab entry automatically.
To enable automatic periodic runs, set INSTALL_CRONTAB=true in the
configuration file and run 'system-update' once.

The package does NOT modify any existing shell, desktop, or cron
configuration during installation.
EOF
}

post_upgrade() {
    cat <<'EOF'
:: awesome-updater has been upgraded.

If the package added new configuration keys and you previously modified
/etc/system-update/config.conf, pacman may have created:
    /etc/system-update/config.conf.pacnew

The package works with its defaults. If you never modified the
configuration file, no action is required.
EOF
}

pre_remove() {
    cat <<'EOF'
:: Removing awesome-updater.

The following are intentionally preserved:

    /var/lib/system-update/       runtime state
    ~/.config/system-update/      user configuration
    ~/logs/                       user logs

To remove them manually:

    sudo rm -rf /var/lib/system-update
    rm -rf ~/.config/system-update
    rm -rf ~/logs

If a crontab entry was created by the previous installation, remove it
manually with:
    crontab -e
EOF
}
#!/bin/bash

# ============================================================================
# Manjaro System Update Script
# ============================================================================
#
# Designed for:
#   - Manjaro Linux servers
#   - Execution from the user's crontab
#   - Passwordless sudo (NOPASSWD)
#   - Unattended official repository updates
#   - Persistent kernel reboot state
#   - One-time automatic reboot at a configurable time
#   - TTY / SSH login notifications
#   - GUI desktop notifications without modifying existing shell configs
#
# IMPORTANT:
#   - Run this script as the normal user, NOT as root.
#   - The script is intended to live at:
#
#       /usr/local/bin/system-update
#
# ============================================================================

set -uo pipefail

# ============================================================================
# USER CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# Official repository updates
# ----------------------------------------------------------------------------
# The script always performs:
#
#   pacman -Syu --noconfirm
#
# This is the only active package update operation by default.
# ----------------------------------------------------------------------------

OFFICIAL_UPDATES_ENABLED=true

# ----------------------------------------------------------------------------
# AUR / yay
# ----------------------------------------------------------------------------
#
# false = disabled (default; no yay installation, no AUR update)
# true  = enabled  (yay is installed if missing, AUR packages are updated)
#
# Set this to true to activate AUR handling. No other change is required.
#
# WARNING:
#   Unattended AUR updates run "yay -Sua --noconfirm", which accepts AUR
#   PKGBUILD changes without review. Only enable this if that risk is
#   understood and accepted.
# ----------------------------------------------------------------------------

AUR_ENABLED=false

# ----------------------------------------------------------------------------
# First-run installation
# ----------------------------------------------------------------------------
#
# Creates only files belonging to this updater.
# Existing unrelated configuration files are NEVER modified.
# ----------------------------------------------------------------------------

INSTALL_ON_FIRST_RUN=true

# ----------------------------------------------------------------------------
# Automatic crontab installation
# ----------------------------------------------------------------------------
#
# false = do not modify the user's crontab automatically
# true  = create/update this script's cron entry
# ----------------------------------------------------------------------------

INSTALL_CRONTAB=false

CRONTAB_SCHEDULE="0 */6 * * *"

# ----------------------------------------------------------------------------
# Login notifications
# ----------------------------------------------------------------------------

# TTY / SSH login notification through /etc/profile.d/
NOTIFY_PROFILE_D=true

# Optional Ubuntu/Debian-style MOTD support.
#
# The script NEVER creates /etc/update-motd.d if it does not already exist.
# This avoids modifying the distribution's login/MOTD infrastructure.
NOTIFY_MOTD=true

# Immediate notification to currently connected terminal sessions.
NOTIFY_WALL=true

# ----------------------------------------------------------------------------
# GUI desktop notification
# ----------------------------------------------------------------------------
#
# A dedicated per-user XDG autostart entry is created.
# No /etc/bash.bashrc, /etc/bashrc, or other existing shell configuration is
# modified.
#
# The helper watches the shared state file and only displays a notification
# when the meaningful state changes.
# ----------------------------------------------------------------------------

NOTIFY_GUI=true

# ----------------------------------------------------------------------------
# Persistent state location
# ----------------------------------------------------------------------------
#
# /var/lib is used instead of $HOME so the system state is independent from
# shell/login environment and survives user-session changes.
# ----------------------------------------------------------------------------

STATE_DIR="/var/lib/system-update"

# ----------------------------------------------------------------------------
# Automatic kernel reboot
# ----------------------------------------------------------------------------
#
# true  = schedule a one-time reboot for the next configured time
# false = report that a manual reboot is required
# ----------------------------------------------------------------------------

AUTOMATIC_REBOOT=true

# Reboot time in local server time.
#
# Example:
#   02:15:00
# ----------------------------------------------------------------------------

REBOOT_TIME="02:15:00"

# ----------------------------------------------------------------------------
# Log retention
# ----------------------------------------------------------------------------

LOG_RETENTION_DAYS=30

# ============================================================================
# Environment
# ============================================================================

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export LC_ALL=C
export LANG=C

# ============================================================================
# Basic identity
# ============================================================================

if [ "$(id -u)" -eq 0 ]; then
    echo "ERROR: This script must be run as a normal user."
    exit 1
fi

CURRENT_USER="$(whoami)"
CURRENT_HOME="$HOME"

STATE_FILE="$STATE_DIR/attention.state"
REBOOT_FLAG="$STATE_DIR/kernel-reboot-needed"
SETUP_MARKER="$STATE_DIR/.setup-complete"

NOTIFY_HELPER="/usr/local/bin/system-update-notify"
PROFILE_NOTIFY="/etc/profile.d/99-system-update.sh"
MOTD_NOTIFY="/etc/update-motd.d/99-system-update"
GUI_NOTIFY="$CURRENT_HOME/.config/autostart/system-update-notify.desktop"

LOCKFILE="/tmp/system-update.lock"

# ============================================================================
# Prevent overlapping executions
# ============================================================================

exec 9>"$LOCKFILE"

if ! flock -n 9; then
    echo "$(date): Another system-update instance is already running. Exiting."
    exit 0
fi

# ============================================================================
# Helper functions
# ============================================================================

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

run_sudo() {
    sudo "$@"
}

# ----------------------------------------------------------------------------
# Install a system-wide file (owned by root).
#
# Existing files are never modified.
# ----------------------------------------------------------------------------

install_system_file() {
    local source_file="$1"
    local target_file="$2"
    local mode="$3"

    if [ -e "$target_file" ]; then
        echo "Existing system file left untouched: $target_file"
        return 0
    fi

    if ! run_sudo install -D -m "$mode" "$source_file" "$target_file"; then
        echo "ERROR: Failed to install system file: $target_file"
        return 1
    fi

    echo "Created system file: $target_file"
    return 0
}

# ----------------------------------------------------------------------------
# Install a per-user file (owned by the invoking user).
#
# Existing files are never modified.
#
# This must NOT use sudo, otherwise the file would become root-owned inside
# the user's home directory and the user could not manage it.
# ----------------------------------------------------------------------------

install_user_file() {
    local source_file="$1"
    local target_file="$2"
    local mode="$3"

    if [ -e "$target_file" ]; then
        echo "Existing user file left untouched: $target_file"
        return 0
    fi

    if ! install -D -m "$mode" "$source_file" "$target_file"; then
        echo "ERROR: Failed to install user file: $target_file"
        return 1
    fi

    echo "Created user file: $target_file"
    return 0
}

# ----------------------------------------------------------------------------
# Read the persistent reboot state.
# ----------------------------------------------------------------------------

read_reboot_flag() {
    PENDING_REBOOT_PACKAGE=""
    PENDING_REBOOT_VERSION=""
    PENDING_REBOOT_RUNNING_VERSION=""
    PENDING_REBOOT_UNIT=""
    PENDING_REBOOT_CREATED_AT=""

    [ -r "$REBOOT_FLAG" ] || return 0

    while IFS='=' read -r KEY VALUE; do
        case "$KEY" in
            KERNEL_PACKAGE)
                PENDING_REBOOT_PACKAGE="$VALUE"
                ;;
            TARGET_VERSION)
                PENDING_REBOOT_VERSION="$VALUE"
                ;;
            RUNNING_VERSION)
                PENDING_REBOOT_RUNNING_VERSION="$VALUE"
                ;;
            REBOOT_UNIT)
                PENDING_REBOOT_UNIT="$VALUE"
                ;;
            CREATED_AT)
                PENDING_REBOOT_CREATED_AT="$VALUE"
                ;;
        esac
    done < "$REBOOT_FLAG"
}

# ----------------------------------------------------------------------------
# Write/update the persistent reboot state.
# ----------------------------------------------------------------------------

write_reboot_flag() {
    local package="$1"
    local target_version="$2"
    local running_version="$3"
    local unit="$4"
    local created_at="$5"

    local tmp

    tmp="$(mktemp)" || return 1

    cat > "$tmp" <<EOF
KERNEL_PACKAGE=$package
TARGET_VERSION=$target_version
RUNNING_VERSION=$running_version
REBOOT_UNIT=$unit
CREATED_AT=$created_at
EOF

    if ! run_sudo install -D -m 644 "$tmp" "$REBOOT_FLAG"; then
        rm -f "$tmp"
        return 1
    fi

    rm -f "$tmp"
    return 0
}

# ----------------------------------------------------------------------------
# Clear the persistent reboot state.
#
# The state file is root-owned, so this MUST use sudo. Without sudo, the
# removal would silently fail and the reboot flag would remain forever.
# ----------------------------------------------------------------------------

clear_reboot_flag() {
    if [ -e "$REBOOT_FLAG" ]; then
        if ! run_sudo rm -f "$REBOOT_FLAG"; then
            echo "WARNING: Failed to remove reboot flag: $REBOOT_FLAG"
            return 1
        fi
    fi
    return 0
}

# ----------------------------------------------------------------------------
# Determine the package providing the currently running kernel.
#
# Preferred:
#   mhwd-kernel -li
#
# Fallback:
#   pacman -Qo /usr/lib/modules/<uname -r>
# ----------------------------------------------------------------------------

detect_running_kernel_package() {
    local running_kernel="$1"
    local mhwd_output=""

    RUNNING_KERNEL_PKG=""

    if command_exists mhwd-kernel; then

        mhwd_output="$(mhwd-kernel -li 2>/dev/null || true)"

        RUNNING_KERNEL_PKG="$(
            printf '%s\n' "$mhwd_output" |
            sed -n 's/^Currently running:.* (\(linux[0-9]\+\)).*/\1/p' |
            head -n 1
        )"

    fi

    if [ -z "$RUNNING_KERNEL_PKG" ] &&
       [ -d "/usr/lib/modules/$running_kernel" ]; then

        RUNNING_KERNEL_PKG="$(
            pacman -Qo "/usr/lib/modules/$running_kernel" 2>/dev/null |
            sed -n 's/.* is owned by \(linux[0-9]\+\) .*/\1/p' |
            head -n 1
        )"

    fi

    [ -n "$RUNNING_KERNEL_PKG" ]
}

# ----------------------------------------------------------------------------
# Normalize standard Manjaro kernel release naming.
#
# Example:
#
#   6.18.50-1-MANJARO
#
# becomes:
#
#   6.18.50-1
# ----------------------------------------------------------------------------

normalize_running_version() {
    local version="$1"
    printf '%s\n' "${version%-MANJARO}"
}

# ----------------------------------------------------------------------------
# Generate a unique transient systemd unit name.
# ----------------------------------------------------------------------------

generate_reboot_unit() {
    printf 'kernel-reboot-%s-%s\n' "$(date +%s)" "$$"
}

# ----------------------------------------------------------------------------
# Cancel a pending transient reboot unit.
# ----------------------------------------------------------------------------

cancel_pending_reboot_unit() {
    local unit="$1"

    [ -n "$unit" ] || return 0

    local timer="${unit}.timer"

    echo "Cancelling pending reboot unit: $unit"

    run_sudo systemctl stop "$timer" 2>/dev/null || true
    run_sudo systemctl reset-failed "$timer" 2>/dev/null || true

    run_sudo systemctl stop "$unit" 2>/dev/null || true
    run_sudo systemctl reset-failed "$unit" 2>/dev/null || true
}

# ----------------------------------------------------------------------------
# Read current attention state.
# ----------------------------------------------------------------------------

read_attention_state() {
    STATE_NEEDS_ATTENTION=0
    STATE_UPDATE_FAILED=0
    STATE_REBOOT_REQUIRED=0
    STATE_REBOOT_SCHEDULE_FAILED=0
    STATE_PACNEW_COUNT=0
    STATE_REASON=""
    STATE_ACTION=""
    STATE_DETAIL=""

    [ -r "$STATE_FILE" ] || return 0

    while IFS='=' read -r KEY VALUE; do
        case "$KEY" in
            NEEDS_ATTENTION)
                STATE_NEEDS_ATTENTION="$VALUE"
                ;;
            UPDATE_FAILED)
                STATE_UPDATE_FAILED="$VALUE"
                ;;
            REBOOT_REQUIRED)
                STATE_REBOOT_REQUIRED="$VALUE"
                ;;
            REBOOT_SCHEDULE_FAILED)
                STATE_REBOOT_SCHEDULE_FAILED="$VALUE"
                ;;
            PACNEW_COUNT)
                STATE_PACNEW_COUNT="$VALUE"
                ;;
            REASON)
                STATE_REASON="$VALUE"
                ;;
            ACTION)
                STATE_ACTION="$VALUE"
                ;;
            DETAIL)
                STATE_DETAIL="$VALUE"
                ;;
        esac
    done < "$STATE_FILE"
}

# ----------------------------------------------------------------------------
# Write the consolidated attention state.
#
# Returns:
#   0 = state did not change
#   1 = state changed
#   2 = write error
# ----------------------------------------------------------------------------

write_attention_state() {
    local needs_attention="$1"
    local update_failed="$2"
    local reboot_required="$3"
    local reboot_schedule_failed="$4"
    local pacnew_count="$5"
    local reason="$6"
    local action="$7"
    local detail="$8"

    local old_signature=""
    local new_signature=""
    local tmp=""

    read_attention_state

    old_signature="$(
        printf '%s\n' \
            "$STATE_NEEDS_ATTENTION" \
            "$STATE_UPDATE_FAILED" \
            "$STATE_REBOOT_REQUIRED" \
            "$STATE_REBOOT_SCHEDULE_FAILED" \
            "$STATE_PACNEW_COUNT" \
            "$STATE_REASON" \
            "$STATE_ACTION" \
            "$STATE_DETAIL" |
        sha256sum |
        awk '{print $1}'
    )"

    new_signature="$(
        printf '%s\n' \
            "$needs_attention" \
            "$update_failed" \
            "$reboot_required" \
            "$reboot_schedule_failed" \
            "$pacnew_count" \
            "$reason" \
            "$action" \
            "$detail" |
        sha256sum |
        awk '{print $1}'
    )"

    tmp="$(mktemp)" || return 2

    cat > "$tmp" <<EOF
NEEDS_ATTENTION=$needs_attention
UPDATE_FAILED=$update_failed
REBOOT_REQUIRED=$reboot_required
REBOOT_SCHEDULE_FAILED=$reboot_schedule_failed
PACNEW_COUNT=$pacnew_count
REASON=$reason
ACTION=$action
DETAIL=$detail
UPDATED_AT=$(date '+%Y-%m-%dT%H:%M:%S%z')
HOSTNAME=$(hostname)
SOURCE=system-update
EOF

    if ! run_sudo install -D -m 644 "$tmp" "$STATE_FILE"; then
        rm -f "$tmp"
        echo "ERROR: Failed to write attention state."
        return 2
    fi

    rm -f "$tmp"

    if [ "$old_signature" != "$new_signature" ]; then
        return 1
    fi

    return 0
}

# ----------------------------------------------------------------------------
# Broadcast a state change to currently connected terminals.
# ----------------------------------------------------------------------------

notify_wall() {
    local reason="$1"
    local action="$2"
    local detail="$3"

    [ "$NOTIFY_WALL" = true ] || return 0

    {
        echo
        echo "============================================================"
        echo "SYSTEM UPDATE ATTENTION REQUIRED"
        echo "============================================================"
        [ -n "$reason" ] && echo "Reason : $reason"
        [ -n "$detail" ] && echo "Detail : $detail"
        [ -n "$action" ] && echo "Action : $action"
        echo "Host   : $(hostname)"
        echo "============================================================"
        echo
    } | run_sudo wall 2>/dev/null || true
}

# ============================================================================
# Check required commands
# ============================================================================

echo
echo "Checking required commands..."

REQUIRED_COMMANDS=(
    bash
    sudo
    pacman
    systemctl
    find
    tee
    ln
    uname
    date
    sed
    awk
    head
    hostname
    grep
    sha256sum
)

if [ "$AUTOMATIC_REBOOT" = true ]; then
    REQUIRED_COMMANDS+=(
        systemd-run
    )
fi

# AUR-related tools are only required when AUR updates are enabled.
if [ "$AUR_ENABLED" = true ]; then
    REQUIRED_COMMANDS+=(
        git
        makepkg
    )
fi

for cmd in "${REQUIRED_COMMANDS[@]}"; do
    if ! command_exists "$cmd"; then
        echo "ERROR: Required command not found: $cmd"
        exit 1
    fi
done

echo "All required commands are available."

# ============================================================================
# Check passwordless sudo
# ============================================================================

echo
echo "Checking passwordless sudo..."

if ! sudo -n true >/dev/null 2>&1; then
    echo "ERROR: Passwordless sudo is not available."
    echo "This script requires unattended sudo access."
    exit 1
fi

echo "Passwordless sudo is available."

# ============================================================================
# Create persistent state directory
# ============================================================================

echo
echo "Checking persistent state directory..."

if ! run_sudo mkdir -p "$STATE_DIR"; then
    echo "ERROR: Cannot create state directory: $STATE_DIR"
    exit 1
fi

run_sudo chmod 755 "$STATE_DIR"

# ============================================================================
# First-run notification infrastructure
# ============================================================================

install_notification_infrastructure() {

    local tmp
    local setup_failed=0

    echo
    echo "============================================================"
    echo "Installing system-update notification infrastructure"
    echo "============================================================"

    # ------------------------------------------------------------------------
    # Common notification helper
    # ------------------------------------------------------------------------

    if [ "$NOTIFY_PROFILE_D" = true ] ||
       [ "$NOTIFY_MOTD" = true ] ||
       [ "$NOTIFY_GUI" = true ]; then

        if [ ! -e "$NOTIFY_HELPER" ]; then

            tmp="$(mktemp)" || return 1

            cat > "$tmp" <<'HELPER_EOF'
#!/bin/bash

# ============================================================================
# system-update-notify
# ============================================================================
#
# Usage:
#   system-update-notify --tty
#   system-update-notify --gui
#   system-update-notify --gui-watch
#
# This file is generated by /usr/local/bin/system-update.
# It reads the shared system-update state and does not modify system config.
# ============================================================================

export LC_ALL=C
export LANG=C

STATE_FILE="/var/lib/system-update/attention.state"

MODE="${1:---tty}"

read_state() {
    NEEDS_ATTENTION=0
    UPDATE_FAILED=0
    REBOOT_REQUIRED=0
    REBOOT_SCHEDULE_FAILED=0
    PACNEW_COUNT=0
    REASON=""
    ACTION=""
    DETAIL=""

    [ -r "$STATE_FILE" ] || return 0

    while IFS='=' read -r KEY VALUE; do
        case "$KEY" in
            NEEDS_ATTENTION) NEEDS_ATTENTION="$VALUE" ;;
            UPDATE_FAILED) UPDATE_FAILED="$VALUE" ;;
            REBOOT_REQUIRED) REBOOT_REQUIRED="$VALUE" ;;
            REBOOT_SCHEDULE_FAILED) REBOOT_SCHEDULE_FAILED="$VALUE" ;;
            PACNEW_COUNT) PACNEW_COUNT="$VALUE" ;;
            REASON) REASON="$VALUE" ;;
            ACTION) ACTION="$VALUE" ;;
            DETAIL) DETAIL="$VALUE" ;;
        esac
    done < "$STATE_FILE"
}

state_signature() {
    read_state

    printf '%s\n' \
        "$NEEDS_ATTENTION" \
        "$UPDATE_FAILED" \
        "$REBOOT_REQUIRED" \
        "$REBOOT_SCHEDULE_FAILED" \
        "$PACNEW_COUNT" \
        "$REASON" \
        "$ACTION" \
        "$DETAIL" |
    sha256sum |
    awk '{print $1}'
}

tty_notification() {

    read_state

    [ "$NEEDS_ATTENTION" = "1" ] || return 0

    RED='\033[1;31m'
    YELLOW='\033[1;33m'
    NC='\033[0m'

    echo
    echo -e "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║${NC}  ${YELLOW}⚠  SYSTEM UPDATE ATTENTION REQUIRED  ⚠${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo

    if [ "$UPDATE_FAILED" = "1" ]; then
        echo -e "   ${YELLOW}Reason:${NC} $REASON"
        echo -e "   ${YELLOW}Action:${NC} $ACTION"
    elif [ "$REBOOT_SCHEDULE_FAILED" = "1" ]; then
        echo -e "   ${YELLOW}Reason:${NC} $REASON"
        echo -e "   ${YELLOW}Action:${NC} $ACTION"
    elif [ "$REBOOT_REQUIRED" = "1" ]; then
        echo -e "   ${YELLOW}Reason:${NC} $REASON"
        echo -e "   ${YELLOW}Action:${NC} $ACTION"
    else
        [ -n "$REASON" ] && echo -e "   ${YELLOW}Reason:${NC} $REASON"
        [ -n "$ACTION" ] && echo -e "   ${YELLOW}Action:${NC} $ACTION"
    fi

    [ -n "$DETAIL" ] && echo -e "   ${YELLOW}Detail:${NC} $DETAIL"

    echo
    echo "   State: $STATE_FILE"
    echo
}

gui_notification() {

    read_state

    [ "$NEEDS_ATTENTION" = "1" ] || return 0
    command -v notify-send >/dev/null 2>&1 || return 0

    local title="System update attention required"
    local body=""

    if [ "$UPDATE_FAILED" = "1" ]; then
        title="System update failed"
    elif [ "$REBOOT_SCHEDULE_FAILED" = "1" ]; then
        title="Kernel reboot scheduling failed"
    elif [ "$REBOOT_REQUIRED" = "1" ]; then
        title="System reboot required"
    fi

    body="$REASON"

    [ -n "$DETAIL" ] && body="${body}\n$DETAIL"
    [ -n "$ACTION" ] && body="${body}\n$ACTION"

    notify-send \
        --urgency=critical \
        --app-name="System Update" \
        "$title" \
        "$body" 2>/dev/null || true
}

gui_watch() {

    local previous_signature=""
    local current_signature=""

    while true; do

        current_signature="$(state_signature 2>/dev/null || true)"

        if [ -n "$current_signature" ] &&
           [ "$current_signature" != "$previous_signature" ]; then

            previous_signature="$current_signature"

            read_state

            if [ "$NEEDS_ATTENTION" = "1" ]; then
                gui_notification
            fi
        fi

        sleep 60
    done
}

case "$MODE" in

    --tty)
        tty_notification
        ;;

    --gui)
        gui_notification
        ;;

    --gui-watch)
        gui_watch
        ;;

    *)
        echo "Usage: system-update-notify [--tty|--gui|--gui-watch]" >&2
        exit 2
        ;;

esac
HELPER_EOF

            if ! install_system_file "$tmp" "$NOTIFY_HELPER" 755; then
                setup_failed=1
            fi

            rm -f "$tmp"

        else

            echo "Existing notification helper left untouched: $NOTIFY_HELPER"

        fi
    fi

    # ------------------------------------------------------------------------
    # /etc/profile.d notification
    # ------------------------------------------------------------------------

    if [ "$NOTIFY_PROFILE_D" = true ]; then

        tmp="$(mktemp)" || return 1

        cat > "$tmp" <<'PROFILE_EOF'
#!/bin/bash

# Auto-generated by /usr/local/bin/system-update.
# This file is sourced by login shells.
#
# IMPORTANT:
#   Never use "exit" here. This file is sourced into the shell that is
#   logging in. "return" is intentionally used instead.

case "$-" in
    *i*) ;;
    *) return 0 2>/dev/null || true ;;
esac

NOTIFY_HELPER="/usr/local/bin/system-update-notify"

[ -x "$NOTIFY_HELPER" ] || return 0 2>/dev/null || true

"$NOTIFY_HELPER" --tty 2>/dev/null || true
PROFILE_EOF

        if ! install_system_file "$tmp" "$PROFILE_NOTIFY" 644; then
            setup_failed=1
        fi

        rm -f "$tmp"
    fi

    # ------------------------------------------------------------------------
    # Optional update-motd.d notification.
    #
    # Never create the directory. Only use it if the distribution already
    # provides it.
    # ------------------------------------------------------------------------

    if [ "$NOTIFY_MOTD" = true ] &&
       [ -d /etc/update-motd.d ]; then

        tmp="$(mktemp)" || return 1

        cat > "$tmp" <<'MOTD_EOF'
#!/bin/bash

# Auto-generated by /usr/local/bin/system-update.

NOTIFY_HELPER="/usr/local/bin/system-update-notify"

[ -x "$NOTIFY_HELPER" ] || exit 0

"$NOTIFY_HELPER" --tty 2>/dev/null || true
MOTD_EOF

        if ! install_system_file "$tmp" "$MOTD_NOTIFY" 755; then
            setup_failed=1
        fi

        rm -f "$tmp"
    fi

    # ------------------------------------------------------------------------
    # Per-user GUI autostart.
    #
    # This does NOT modify /etc/bash.bashrc, /etc/profile, or any existing
    # desktop configuration.
    #
    # The file is installed into the user's home directory and MUST be owned
    # by the user, not by root.
    # ------------------------------------------------------------------------

    if [ "$NOTIFY_GUI" = true ]; then

        tmp="$(mktemp)" || return 1

        cat > "$tmp" <<'DESKTOP_EOF'
[Desktop Entry]
Type=Application
Name=System Update Notification
Comment=Monitors system-update attention state
Exec=/usr/local/bin/system-update-notify --gui-watch
Terminal=false
X-GNOME-Autostart-enabled=true
DESKTOP_EOF

        if ! install_user_file "$tmp" "$GUI_NOTIFY" 644; then
            setup_failed=1
        fi

        rm -f "$tmp"
    fi

    # ------------------------------------------------------------------------
    # Setup marker
    # ------------------------------------------------------------------------

    if [ "$setup_failed" -eq 0 ]; then
        run_sudo touch "$SETUP_MARKER" || setup_failed=1
        run_sudo chmod 644 "$SETUP_MARKER" 2>/dev/null || true
    fi

    if [ "$setup_failed" -ne 0 ]; then
        echo "WARNING: Some notification setup operations failed."
        return 1
    fi

    echo "Notification infrastructure setup completed."
    return 0
}

# ============================================================================
# First-run infrastructure
# ============================================================================

if [ "$INSTALL_ON_FIRST_RUN" = true ]; then

    if [ ! -f "$SETUP_MARKER" ] ||
       { [ "$NOTIFY_PROFILE_D" = true ] &&
         [ ! -f "$PROFILE_NOTIFY" ]; }; then

        if ! install_notification_infrastructure; then

            echo "WARNING: Notification infrastructure setup was not fully"
            echo "successful. The package update itself will continue."

        fi

    else

        echo
        echo "Notification infrastructure already installed."

    fi
fi

# ============================================================================
# Optional crontab installation
# ============================================================================

CRON_INSTALL_FAILED=0

if [ "$INSTALL_CRONTAB" = true ]; then

    echo
    echo "Checking user crontab..."

    if ! command_exists crontab; then

        echo "ERROR: crontab command is not available."
        CRON_INSTALL_FAILED=1

    else

        SCRIPT_PATH="/usr/local/bin/system-update"
        CRON_ENTRY="$CRONTAB_SCHEDULE $SCRIPT_PATH >/dev/null 2>&1"

        EXISTING_CRONTAB="$(crontab -l 2>/dev/null || true)"

        # Remove only existing entries referring to this exact updater.
        FILTERED_CRONTAB="$(
            printf '%s\n' "$EXISTING_CRONTAB" |
            grep -vF "$SCRIPT_PATH" || true
        )"

        NEW_CRONTAB="$FILTERED_CRONTAB"

        if [ -n "$NEW_CRONTAB" ]; then
            NEW_CRONTAB="${NEW_CRONTAB}"$'\n'
        fi

        NEW_CRONTAB="${NEW_CRONTAB}${CRON_ENTRY}"

        if printf '%s\n' "$NEW_CRONTAB" | crontab -; then

            echo "System-update cron entry installed:"
            echo "  $CRON_ENTRY"

        else

            echo "ERROR: Failed to install system-update cron entry."
            CRON_INSTALL_FAILED=1

        fi
    fi
fi

# ============================================================================
# Detect currently running kernel
# ============================================================================

echo
echo "Detecting currently running kernel..."

RUNNING_KERNEL="$(uname -r)"

if ! detect_running_kernel_package "$RUNNING_KERNEL"; then

    echo "ERROR: Could not determine the package providing the running kernel."
    echo "Running kernel: $RUNNING_KERNEL"

    write_attention_state \
        1 \
        1 \
        0 \
        0 \
        0 \
        "Could not determine the running kernel package" \
        "Review the system-update log and kernel state manually" \
        "Running kernel: $RUNNING_KERNEL"

    exit 1
fi

echo "Running kernel version: $RUNNING_KERNEL"
echo "Running kernel package: $RUNNING_KERNEL_PKG"

# ============================================================================
# Process an existing pending reboot state
# ============================================================================

read_reboot_flag

if [ -n "$PENDING_REBOOT_PACKAGE" ] ||
   [ -n "$PENDING_REBOOT_VERSION" ] ||
   [ -n "$PENDING_REBOOT_RUNNING_VERSION" ] ||
   [ -n "$PENDING_REBOOT_UNIT" ]; then

    echo
    echo "Pending kernel reboot state detected."

    echo "  Package : $PENDING_REBOOT_PACKAGE"
    echo "  Target  : $PENDING_REBOOT_VERSION"
    echo "  Old run : $PENDING_REBOOT_RUNNING_VERSION"
    echo "  Unit    : $PENDING_REBOOT_UNIT"
    echo "  Created : $PENDING_REBOOT_CREATED_AT"

    if [ -z "$PENDING_REBOOT_PACKAGE" ] ||
       [ -z "$PENDING_REBOOT_VERSION" ] ||
       [ -z "$PENDING_REBOOT_RUNNING_VERSION" ]; then

        echo "WARNING: Reboot state is incomplete."

        if [ -n "$PENDING_REBOOT_UNIT" ]; then
            cancel_pending_reboot_unit "$PENDING_REBOOT_UNIT"
        fi

        clear_reboot_flag

        PENDING_REBOOT_PACKAGE=""
        PENDING_REBOOT_VERSION=""
        PENDING_REBOOT_RUNNING_VERSION=""
        PENDING_REBOOT_UNIT=""
        PENDING_REBOOT_CREATED_AT=""

    elif ! pacman -Q "$PENDING_REBOOT_PACKAGE" >/dev/null 2>&1; then

        echo "The pending kernel package is no longer installed."

        cancel_pending_reboot_unit "$PENDING_REBOOT_UNIT"
        clear_reboot_flag

        PENDING_REBOOT_PACKAGE=""
        PENDING_REBOOT_VERSION=""
        PENDING_REBOOT_RUNNING_VERSION=""
        PENDING_REBOOT_UNIT=""
        PENDING_REBOOT_CREATED_AT=""

    elif [ "$RUNNING_KERNEL_PKG" != "$PENDING_REBOOT_PACKAGE" ]; then

        echo
        echo "The pending target kernel package is not currently running."
        echo "Keeping the persistent reboot state."

    else

        RUNNING_KERNEL_NORMALIZED="$(normalize_running_version "$RUNNING_KERNEL")"

        VERSION_COMPARISON="$(
            vercmp \
                "$RUNNING_KERNEL_NORMALIZED" \
                "$PENDING_REBOOT_VERSION" \
                2>/dev/null
        )"

        if ! [[ "$VERSION_COMPARISON" =~ ^-?[0-9]+$ ]]; then

            echo "ERROR: Could not compare running kernel to target version."
            echo "Keeping the persistent reboot state."

        elif [ "$VERSION_COMPARISON" -ge 0 ]; then

            echo
            echo "The target kernel package/version is now actually running."
            echo "The required reboot has completed."

            if [ -n "$PENDING_REBOOT_UNIT" ]; then
                cancel_pending_reboot_unit "$PENDING_REBOOT_UNIT"
            fi

            clear_reboot_flag

            PENDING_REBOOT_PACKAGE=""
            PENDING_REBOOT_VERSION=""
            PENDING_REBOOT_RUNNING_VERSION=""
            PENDING_REBOOT_UNIT=""
            PENDING_REBOOT_CREATED_AT=""

        else

            echo
            echo "The target kernel is installed but is not yet running."

        fi
    fi
fi

# ============================================================================
# Record installed kernels BEFORE update
# ============================================================================

echo
echo "Recording installed kernel packages before update..."

declare -A KERNEL_BEFORE

while read -r pkg ver; do
    [ -n "$pkg" ] || continue
    KERNEL_BEFORE["$pkg"]="$ver"
    echo "  $pkg $ver"
done < <(
    pacman -Q 2>/dev/null |
    awk '$1 ~ /^linux[0-9]+$/ {print $1, $2}'
)

if [ "${#KERNEL_BEFORE[@]}" -eq 0 ]; then

    echo "ERROR: No installed Manjaro kernel packages were detected."

    write_attention_state \
        1 \
        1 \
        0 \
        0 \
        0 \
        "No installed Manjaro kernel packages were detected" \
        "Review kernel installation before continuing unattended maintenance" \
        "pacman -Q returned no linuxNNN kernel packages"

    exit 1
fi

# ============================================================================
# Official system update
# ============================================================================

if [ "$OFFICIAL_UPDATES_ENABLED" = true ]; then

    echo
    echo "============================================================"
    echo "Updating official Manjaro packages"
    echo "============================================================"

    if ! run_sudo pacman -Syu --noconfirm; then

        echo "ERROR: Official package update failed."

        read_reboot_flag

        UPDATE_FAILED_REBOOT=0

        if [ -n "$PENDING_REBOOT_PACKAGE" ] &&
           [ -n "$PENDING_REBOOT_VERSION" ] &&
           [ -n "$PENDING_REBOOT_RUNNING_VERSION" ]; then
            UPDATE_FAILED_REBOOT=1
        fi

        write_attention_state \
            1 \
            1 \
            "$UPDATE_FAILED_REBOOT" \
            0 \
            0 \
            "Official system update failed" \
            "Review the system-update log and resolve the package-manager error" \
            "pacman -Syu returned a non-zero status"

        notify_wall \
            "Official system update failed" \
            "Review the system-update log and resolve the package-manager error" \
            "pacman -Syu returned a non-zero status"

        exit 1
    fi

    echo "Official package update completed successfully."

else

    echo
    echo "Official updates are disabled by configuration."

fi

# ============================================================================
# AUR / yay update section
# ============================================================================
#
# This section is ACTIVE. It runs only when AUR_ENABLED=true.
#
# By default AUR_ENABLED=false, so:
#   - yay is not installed if missing
#   - yay -Sua is not executed
#
# Setting AUR_ENABLED=true at the top of the script immediately activates
# this whole block without any further edits.
#
# WARNING:
#   Unattended AUR updates accept PKGBUILD changes without review.
# ============================================================================

if [ "$AUR_ENABLED" = true ]; then

    echo
    echo "============================================================"
    echo "AUR support is enabled"
    echo "============================================================"

    # ------------------------------------------------------------------------
    # Install yay if missing
    # ------------------------------------------------------------------------

    if ! command_exists yay; then

        echo "yay is not installed. Installing it from the AUR."

        if ! run_sudo pacman -S --needed --noconfirm base-devel git; then

            echo "ERROR: Failed to install yay build dependencies."

            write_attention_state \
                1 \
                1 \
                0 \
                0 \
                0 \
                "Failed to install yay build dependencies" \
                "AUR_ENABLED=true requires base-devel and git" \
                "pacman -S base-devel git returned a non-zero status"

            exit 1
        fi

        YAY_BUILD_DIR="$CURRENT_HOME/.cache/yay-bootstrap"

        rm -rf "$YAY_BUILD_DIR"

        if ! mkdir -p "$(dirname "$YAY_BUILD_DIR")"; then
            echo "ERROR: Cannot create yay bootstrap directory."
            exit 1
        fi

        if ! git clone \
            https://aur.archlinux.org/yay.git \
            "$YAY_BUILD_DIR"; then

            echo "ERROR: Failed to clone yay."

            write_attention_state \
                1 \
                1 \
                0 \
                0 \
                0 \
                "Failed to clone yay from the AUR" \
                "Check network connectivity to aur.archlinux.org" \
                "git clone returned a non-zero status"

            exit 1
        fi

        cd "$YAY_BUILD_DIR" || {
            echo "ERROR: Cannot enter yay build directory."
            exit 1
        }

        if ! makepkg -si --noconfirm; then

            echo "ERROR: Failed to build/install yay."

            write_attention_state \
                1 \
                1 \
                0 \
                0 \
                0 \
                "Failed to build/install yay" \
                "Review the makepkg output in the system-update log" \
                "makepkg -si returned a non-zero status"

            exit 1
        fi

        cd "$CURRENT_HOME" || true

        if ! command_exists yay; then
            echo "ERROR: yay is still unavailable after installation."
            exit 1
        fi

        echo "yay installed successfully."

    else

        echo "yay is already installed."

    fi

    # ------------------------------------------------------------------------
    # Update AUR packages only
    # ------------------------------------------------------------------------
    #
    # Official packages were already handled by pacman -Syu.
    # yay -Sua therefore only touches AUR packages.
    # ------------------------------------------------------------------------

    echo
    echo "Updating AUR packages..."

    if ! yay -Sua --noconfirm; then

        echo "ERROR: AUR package update failed."

        write_attention_state \
            1 \
            1 \
            0 \
            0 \
            0 \
            "AUR package update failed" \
            "Review the yay output in the system-update log" \
            "yay -Sua returned a non-zero status"

        notify_wall \
            "AUR package update failed" \
            "Review the system-update log" \
            "yay -Sua returned a non-zero status"

        exit 1
    fi

    echo "AUR package update completed successfully."

else

    echo
    echo "AUR updates:"
    echo "  Disabled (AUR_ENABLED=false)."

fi

# ============================================================================
# Record installed kernels AFTER update
# ============================================================================

echo
echo "Recording installed kernel packages after update..."

declare -A KERNEL_AFTER

while read -r pkg ver; do
    [ -n "$pkg" ] || continue
    KERNEL_AFTER["$pkg"]="$ver"
    echo "  $pkg $ver"
done < <(
    pacman -Q 2>/dev/null |
    awk '$1 ~ /^linux[0-9]+$/ {print $1, $2}'
)

if [ "${#KERNEL_AFTER[@]}" -eq 0 ]; then

    echo "ERROR: No installed Manjaro kernel packages were detected after update."

    write_attention_state \
        1 \
        1 \
        0 \
        0 \
        0 \
        "No installed Manjaro kernel packages were detected after update" \
        "Review the update and kernel installation state" \
        "The kernel package inventory could not be reconstructed"

    exit 1
fi

# ============================================================================
# Detect kernel package changes
# ============================================================================

KERNEL_PACKAGE_CHANGED=0
RUNNING_KERNEL_PACKAGE_CHANGED=0
TARGET_KERNEL_VERSION=""

echo
echo "Comparing kernel package versions..."

for pkg in "${!KERNEL_BEFORE[@]}"; do

    BEFORE_VERSION="${KERNEL_BEFORE[$pkg]}"
    AFTER_VERSION="${KERNEL_AFTER[$pkg]:-NOT_INSTALLED}"

    if [ "$BEFORE_VERSION" != "$AFTER_VERSION" ]; then

        echo
        echo "Kernel package changed:"
        echo "  Package: $pkg"
        echo "  Before : $BEFORE_VERSION"
        echo "  After  : $AFTER_VERSION"

        KERNEL_PACKAGE_CHANGED=1

        if [ "$pkg" = "$RUNNING_KERNEL_PKG" ]; then
            RUNNING_KERNEL_PACKAGE_CHANGED=1
            TARGET_KERNEL_VERSION="$AFTER_VERSION"
        fi

    fi
done

# Detect newly installed Manjaro kernel packages.
for pkg in "${!KERNEL_AFTER[@]}"; do

    if [ -z "${KERNEL_BEFORE[$pkg]+x}" ]; then

        echo
        echo "New kernel package installed:"
        echo "  Package: $pkg"
        echo "  Version: ${KERNEL_AFTER[$pkg]}"

        KERNEL_PACKAGE_CHANGED=1
    fi
done

# ============================================================================
# Persist or update reboot state
# ============================================================================
#
# If no reboot is pending:
#   create a new state.
#
# If a reboot is already pending for the same kernel package:
#   update only the target version.
#
# The original running kernel and original creation time are preserved.
# The existing reboot unit is also preserved.
# ============================================================================

read_reboot_flag

if [ "$RUNNING_KERNEL_PACKAGE_CHANGED" -eq 1 ]; then

    echo
    echo "The package providing the currently running kernel was updated."

    if [ -n "$PENDING_REBOOT_PACKAGE" ] &&
       [ "$PENDING_REBOOT_PACKAGE" = "$RUNNING_KERNEL_PKG" ] &&
       [ -n "$PENDING_REBOOT_RUNNING_VERSION" ]; then

        echo "A reboot is already pending for this kernel package."
        echo "Updating the target version only."

        ORIGINAL_CREATED_AT="$PENDING_REBOOT_CREATED_AT"
        ORIGINAL_RUNNING_VERSION="$PENDING_REBOOT_RUNNING_VERSION"
        EXISTING_REBOOT_UNIT="$PENDING_REBOOT_UNIT"

        if [ -z "$ORIGINAL_CREATED_AT" ]; then
            ORIGINAL_CREATED_AT="$(date '+%Y-%m-%dT%H:%M:%S%z')"
        fi

        if ! write_reboot_flag \
            "$RUNNING_KERNEL_PKG" \
            "$TARGET_KERNEL_VERSION" \
            "$ORIGINAL_RUNNING_VERSION" \
            "$EXISTING_REBOOT_UNIT" \
            "$ORIGINAL_CREATED_AT"; then

            echo "ERROR: Failed to update persistent reboot state."
            exit 1
        fi

    else

        echo "Creating a new persistent reboot requirement."

        NEW_REBOOT_UNIT="$(generate_reboot_unit)"
        CREATED_AT="$(date '+%Y-%m-%dT%H:%M:%S%z')"

        if ! write_reboot_flag \
            "$RUNNING_KERNEL_PKG" \
            "$TARGET_KERNEL_VERSION" \
            "$RUNNING_KERNEL" \
            "$NEW_REBOOT_UNIT" \
            "$CREATED_AT"; then

            echo "ERROR: Failed to create persistent reboot state."
            exit 1
        fi

    fi
fi

# ============================================================================
# Refresh reboot state
# ============================================================================

read_reboot_flag

REBOOT_REQUIRED=0

if [ -n "$PENDING_REBOOT_PACKAGE" ] &&
   [ -n "$PENDING_REBOOT_VERSION" ] &&
   [ -n "$PENDING_REBOOT_RUNNING_VERSION" ]; then
    REBOOT_REQUIRED=1
fi

# ============================================================================
# Schedule one-time kernel reboot
# ============================================================================

REBOOT_SCHEDULE_FAILED=0

if [ "$REBOOT_REQUIRED" -eq 1 ]; then

    echo
    echo "============================================================"
    echo "Kernel reboot state"
    echo "============================================================"

    if [ "$AUTOMATIC_REBOOT" = false ]; then

        echo "Automatic reboot is disabled."
        echo "Manual reboot is required."

    else

        # Verify that the requested systemd-run features exist.
        if ! systemd-run --help 2>/dev/null | grep -q -- '--collect'; then

            echo "ERROR: systemd-run does not support --collect."
            REBOOT_SCHEDULE_FAILED=1

        elif ! systemd-run --help 2>/dev/null | grep -q -- '--on-calendar'; then

            echo "ERROR: systemd-run does not support --on-calendar."
            REBOOT_SCHEDULE_FAILED=1

        else

            EXISTING_REBOOT_TIMER=""

            if [ -n "$PENDING_REBOOT_UNIT" ]; then
                EXISTING_REBOOT_TIMER="${PENDING_REBOOT_UNIT}.timer"
            fi

            TIMER_ACTIVE=0

            if [ -n "$EXISTING_REBOOT_TIMER" ] &&
               run_sudo systemctl is-active --quiet \
                    "$EXISTING_REBOOT_TIMER" 2>/dev/null; then

                TIMER_ACTIVE=1
            fi

            if [ "$TIMER_ACTIVE" -eq 1 ]; then

                echo "An existing one-time reboot timer is already active."
                echo "Timer: $EXISTING_REBOOT_TIMER"
                echo "Leaving it untouched."

            else

                NOW_EPOCH="$(date +%s)"

                TODAY_REBOOT_EPOCH="$(
                    date -d "today $REBOOT_TIME" +%s
                )"

                if [ "$TODAY_REBOOT_EPOCH" -gt "$NOW_EPOCH" ]; then
                    REBOOT_AT="$(
                        date -d "today $REBOOT_TIME" '+%Y-%m-%d %H:%M:%S'
                    )"
                else
                    REBOOT_AT="$(
                        date -d "tomorrow $REBOOT_TIME" '+%Y-%m-%d %H:%M:%S'
                    )"
                fi

                # The unit name stored in the flag may refer to an old failed
                # transient unit. Use a new unique unit for this retry.
                NEW_REBOOT_UNIT="$(generate_reboot_unit)"

                echo "Scheduling one-time kernel reboot for:"
                echo "  $REBOOT_AT"
                echo "Transient unit:"
                echo "  $NEW_REBOOT_UNIT"

                ORIGINAL_CREATED_AT="$PENDING_REBOOT_CREATED_AT"

                if [ -z "$ORIGINAL_CREATED_AT" ]; then
                    ORIGINAL_CREATED_AT="$(date '+%Y-%m-%dT%H:%M:%S%z')"
                fi

                # Persist the unit name BEFORE attempting systemd-run.
                # If systemd-run fails, the reboot requirement remains known
                # and the next cron run can retry with another unique unit.
                if ! write_reboot_flag \
                    "$PENDING_REBOOT_PACKAGE" \
                    "$PENDING_REBOOT_VERSION" \
                    "$PENDING_REBOOT_RUNNING_VERSION" \
                    "$NEW_REBOOT_UNIT" \
                    "$ORIGINAL_CREATED_AT"; then

                    echo "ERROR: Failed to update reboot scheduling state."
                    REBOOT_SCHEDULE_FAILED=1

                else

                    SYSTEMD_RUN_OUTPUT="$(
                        run_sudo systemd-run \
                            --collect \
                            --unit="$NEW_REBOOT_UNIT" \
                            --on-calendar="$REBOOT_AT" \
                            --description="One-time reboot after kernel package update" \
                            /usr/bin/systemctl reboot --no-block \
                            2>&1
                    )"

                    SYSTEMD_RUN_STATUS=$?

                    if [ "$SYSTEMD_RUN_STATUS" -eq 0 ]; then

                        echo "One-time kernel reboot timer created successfully."

                    else

                        echo "ERROR: Failed to create the one-time reboot timer."
                        echo "systemd-run output:"
                        printf '%s\n' "$SYSTEMD_RUN_OUTPUT"

                        REBOOT_SCHEDULE_FAILED=1

                    fi
                fi

            fi
        fi
    fi
fi

# ============================================================================
# Detect .pacnew files
# ============================================================================

echo
echo "Checking for .pacnew files..."

PACNEW_COUNT="$(
    find /etc \
        -type f \
        -name '*.pacnew' \
        2>/dev/null |
    wc -l
)"

PACNEW_COUNT="${PACNEW_COUNT//[[:space:]]/}"

echo ".pacnew files found: $PACNEW_COUNT"

if [ "$PACNEW_COUNT" -gt 0 ]; then

    echo
    echo "WARNING: The following .pacnew files require manual review:"

    find /etc \
        -type f \
        -name '*.pacnew' \
        2>/dev/null |
    sed 's/^/  /'

fi

# ============================================================================
# Package cache
# ============================================================================
#
# Deliberately do not run pacman -Sc.
# Keeping cached packages is useful for server rollback/downgrade operations.
# ============================================================================

echo
echo "Package cache cleanup:"
echo "  Skipped intentionally for server operation."

# ============================================================================
# Final attention state
# ============================================================================

UPDATE_FAILED=0

if [ "$CRON_INSTALL_FAILED" -eq 1 ]; then
    UPDATE_FAILED=1
fi

# UPDATE_FAILED is not affected by reboot state.
# A successful reboot scheduling does not clear an administrative failure.

# Determine whether any user attention is required.
ATTENTION_REQUIRED=0

REASON=""
ACTION=""
DETAIL=""

# Highest priority: update/administrative failure.
if [ "$CRON_INSTALL_FAILED" -eq 1 ]; then

    ATTENTION_REQUIRED=1
    REASON="Automatic cron installation failed"
    ACTION="Check the user crontab and install the intended entry manually"

elif [ "$REBOOT_SCHEDULE_FAILED" -eq 1 ]; then

    ATTENTION_REQUIRED=1
    REASON="Kernel reboot scheduling failed"
    ACTION="Check the system-update log; the reboot requirement remains pending"
    DETAIL="The target kernel is installed but the one-time reboot timer could not be created"

elif [ "$REBOOT_REQUIRED" -eq 1 ]; then

    ATTENTION_REQUIRED=1
    REASON="Kernel reboot required"
    ACTION="Reboot the server; automatic reboot is scheduled for $REBOOT_TIME"

    if [ "$AUTOMATIC_REBOOT" = false ]; then
        ACTION="Reboot the server manually"
    fi

    DETAIL="Running: $RUNNING_KERNEL / Target: $PENDING_REBOOT_VERSION"

fi

if [ "$PACNEW_COUNT" -gt 0 ]; then

    ATTENTION_REQUIRED=1

    if [ -n "$REASON" ]; then
        REASON="$REASON | .pacnew files require review"
    else
        REASON=".pacnew files require review"
    fi

    if [ -n "$ACTION" ]; then
        ACTION="$ACTION | Review /etc/*.pacnew files"
    else
        ACTION="Review the .pacnew files before relying on the updated configuration"
    fi

    if [ -n "$DETAIL" ]; then
        DETAIL="$DETAIL | $PACNEW_COUNT .pacnew file(s)"
    else
        DETAIL="$PACNEW_COUNT .pacnew file(s) found"
    fi

fi

if [ "$ATTENTION_REQUIRED" -eq 0 ]; then

    REASON=""
    ACTION=""
    DETAIL=""

fi

# Write consolidated state.
write_attention_state \
    "$ATTENTION_REQUIRED" \
    "$UPDATE_FAILED" \
    "$REBOOT_REQUIRED" \
    "$REBOOT_SCHEDULE_FAILED" \
    "$PACNEW_COUNT" \
    "$REASON" \
    "$ACTION" \
    "$DETAIL"

STATE_WRITE_RESULT=$?

if [ "$STATE_WRITE_RESULT" -eq 1 ]; then
    STATE_CHANGED=1
elif [ "$STATE_WRITE_RESULT" -eq 0 ]; then
    STATE_CHANGED=0
else
    STATE_CHANGED=0
    echo "WARNING: Failed to persist attention state."
fi

# Notify active terminal sessions only when the meaningful state changed.
if [ "$STATE_CHANGED" -eq 1 ] &&
   [ "$ATTENTION_REQUIRED" -eq 1 ]; then

    notify_wall "$REASON" "$ACTION" "$DETAIL"

fi

# ============================================================================
# Final status
# ============================================================================

echo
echo "============================================================"
echo "Final system status"
echo "============================================================"

FINAL_RUNNING_KERNEL="$(uname -r)"

echo "Currently running kernel:"
echo "  $FINAL_RUNNING_KERNEL"

if detect_running_kernel_package "$FINAL_RUNNING_KERNEL"; then
    FINAL_RUNNING_KERNEL_PKG="$RUNNING_KERNEL_PKG"
else
    FINAL_RUNNING_KERNEL_PKG="unknown"
fi

echo "Currently running kernel package:"
echo "  $FINAL_RUNNING_KERNEL_PKG"

FINAL_RUNNING_KERNEL_VERSION="$(
    pacman -Q "$FINAL_RUNNING_KERNEL_PKG" 2>/dev/null |
    awk '{print $2}'
)"

if [ -n "$FINAL_RUNNING_KERNEL_VERSION" ]; then
    echo "Installed package version:"
    echo "  $FINAL_RUNNING_KERNEL_VERSION"
fi

if command_exists mhwd-kernel; then
    echo
    echo "Manjaro kernel information:"
    mhwd-kernel -li 2>/dev/null || true
fi

echo

read_reboot_flag

if [ -n "$PENDING_REBOOT_PACKAGE" ] &&
   [ -n "$PENDING_REBOOT_VERSION" ] &&
   [ -n "$PENDING_REBOOT_RUNNING_VERSION" ]; then

    echo "REBOOT REQUIRED: yes"
    echo "  Package : $PENDING_REBOOT_PACKAGE"
    echo "  Target  : $PENDING_REBOOT_VERSION"
    echo "  Old run : $PENDING_REBOOT_RUNNING_VERSION"
    echo "  Unit    : $PENDING_REBOOT_UNIT"
    echo "  Created : $PENDING_REBOOT_CREATED_AT"

    if [ -n "$PENDING_REBOOT_UNIT" ]; then

        FINAL_REBOOT_TIMER="${PENDING_REBOOT_UNIT}.timer"

        if run_sudo systemctl is-active --quiet \
            "$FINAL_REBOOT_TIMER" 2>/dev/null; then

            echo
            echo "Reboot timer: active"

            run_sudo systemctl list-timers \
                "$FINAL_REBOOT_TIMER" \
                --no-pager || true

        else

            echo
            if [ "$AUTOMATIC_REBOOT" = true ]; then
                echo "WARNING: Reboot is required, but no active reboot timer exists."
                echo "A later cron execution will retry scheduling it."
            else
                echo "Automatic reboot is disabled."
                echo "Manual reboot is required."
            fi

        fi
    fi

else

    echo "REBOOT REQUIRED: no"

fi

echo
echo "Attention state:"

if [ -r "$STATE_FILE" ]; then

    while IFS= read -r line; do
        echo "  $line"
    done < "$STATE_FILE"

else

    echo "  State file is not available."

fi

# ============================================================================
# Update latest log symlink
# ============================================================================

ln -sfn "$LOG_FILE" "$LATEST_LOG"

# ============================================================================
# Remove old logs
# ============================================================================

echo
echo "Cleaning update logs older than $LOG_RETENTION_DAYS days..."

find "$LOG_DIR" \
    -name "system-update_*.log" \
    -type f \
    -mtime +"$LOG_RETENTION_DAYS" \
    -delete 2>/dev/null || true

if [ -L "$LATEST_LOG" ] &&
   [ ! -e "$LATEST_LOG" ]; then
    rm -f "$LATEST_LOG"
fi

echo "Log cleanup completed."

# ============================================================================
# Finish
# ============================================================================

echo
echo "============================================================"
echo "System update completed"
echo "Date: $(date)"
echo "Log file: $LOG_FILE"
echo "Latest log: $LATEST_LOG"
echo "============================================================"

sleep 0.1
